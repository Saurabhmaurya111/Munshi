{
  "name": "munshi",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=api --filter=worker --filter=web",
    "dev:stack": "npm run dev",
    "dev:api": "turbo run dev --filter=api",
    "dev:worker": "turbo run dev --filter=worker",
    "dev:web": "turbo run dev --filter=web",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "eval": "npm run test --workspace=worker -- test/evals",
    "eval:judge": "EVAL_LLM_JUDGE=1 npm run test --workspace=worker -- test/evals",
    "db:up": "docker compose up -d redis",
    "db:up:local": "docker compose --profile local-db up -d",
    "db:down": "docker compose --profile local-db down",
    "db:logs": "docker compose logs -f redis postgres",
    "db:psql": "docker compose exec postgres psql -U munshi -d munshi",
    "db:reset": "docker compose --profile local-db down -v && docker compose --profile local-db up -d",
    "db:migrate": "node --env-file=.env scripts/db-migrate.mjs",
    "redis:ping": "node --env-file=.env scripts/redis-ping.mjs",
    "knowledge:ingest": "npm run knowledge:ingest --workspace=worker"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "redis": "^5.12.1",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.19.0",
      "onFail": "warn"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
