# Copy to .env for local apps and docker compose.
# Never commit .env.

# Hosted Postgres (preferred). Pooler URL for Supabase if direct db.* is IPv6-only.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://munshi:munshi@localhost:5432/munshi

# Optional local Docker Postgres (npm run db:up:local)
POSTGRES_USER=munshi
POSTGRES_PASSWORD=munshi
POSTGRES_DB=munshi
POSTGRES_PORT=5432

# Hosted Redis (preferred). Redis Cloud example:
# REDIS_URL=redis://default:PASSWORD@HOST:PORT
REDIS_URL=redis://localhost:6379

# Optional local Docker Redis (npm run db:up)
REDIS_PORT=6379

# API
API_PORT=3001
# Optional dedicated Postgres URL for LISTEN/NOTIFY (session mode). Falls back
# to in-process fan-out when unset; transaction-mode poolers cannot LISTEN.
# DATABASE_LISTEN_URL=

# Worker → API Socket.io bridge (required when using a transaction-mode pooler).
# Point at the API so case events from the worker reach chat/desk websockets.
# CASE_EVENT_FANOUT_URL=http://127.0.0.1:3001/v1/internal/case-events/fanout
# CASE_EVENT_FANOUT_SECRET=

# Desk login (web /desk + API /v1/desk/*)
DESK_ID=approver
DESK_PASSWORD=munshi-desk

# Worker (B3 claim loop)
# WORKER_ID=worker-local-1
LEASE_MS=30000
WORKER_POLL_MS=500

# Optional Sarvam LLM for intent classification and customer replies.
# Classification falls back to rules. Replies fall back to the verified draft.
# https://docs.sarvam.ai/api-reference/chat/chat-completions-v1
# SARVAM_API_KEY=sk_xxx
# SARVAM_MODEL=sarvam-105b

# Optional OpenAI embeddings for policy retrieval (falls back to an offline embedder).
# Re-run npm run knowledge:ingest after changing this.
# OPENAI_API_KEY=sk-xxx
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Web chat → API (local split-port). On Vercel Services, leave unset in the
# browser so same-origin /v1 and /socket.io rewrites hit the `api` service.
# Server-side Next.js uses the injected binding API_URL (do not set API_URL).
# NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
# NEXT_PUBLIC_CUSTOMER_ID=customer-soham

# Optional extra CORS origins (comma-separated) for the API, e.g. custom domains.
# CORS_ORIGINS=https://munshi.example.com
