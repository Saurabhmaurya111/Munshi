# Copy to .env for local apps and docker compose.
# Never commit .env.

# Hosted Postgres (preferred). Add ?sslmode=require for Supabase.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://munshi:munshi@localhost:5432/munshi

# Optional local Docker Postgres (npm run db:up:local)
POSTGRES_USER=munshi
POSTGRES_PASSWORD=munshi
POSTGRES_DB=munshi
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
