{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "hono",
      "entrypoint": "src/vercel.ts",
      "installCommand": "cd ../.. && npm install",
      "buildCommand": "cd ../.. && npx turbo run build --filter=api"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && npm install",
      "buildCommand": "cd ../.. && npx turbo run build --filter=web",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": { "service": "api" }
    },
    {
      "source": "/v1/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/socket.io/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
